{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ascendancy target fingerprint manifest",
  "type": "object",
  "required": [
    "schema",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "id",
        "filename",
        "label",
        "size",
        "sha256",
        "container",
        "capture",
        "warnings"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "container": {
          "type": "object",
          "required": [
            "detected_format",
            "architecture"
          ],
          "properties": {
            "detected_format": {
              "type": "string"
            },
            "architecture": {
              "type": [
                "string",
                "null"
              ]
            },
            "mz": {
              "type": "object"
            },
            "le": {
              "type": "object"
            },
            "extender": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "capture": {
          "type": "object",
          "required": [
            "tool",
            "version",
            "command",
            "path_policy"
          ],
          "properties": {
            "tool": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "path_policy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
